
CONFIG_CCACHE=y                             # 启用编译缓存，加速后续编译
CONFIG_PACKAGE_default-settings=y           # 包含默认设置
CONFIG_PACKAGE_default-settings-chn=y       # 包含中国区默认设置（时区、源等）
CONFIG_TARGET_PER_DEVICE_ROOTFS=y           # 为每个设备生成独立的rootfs
CONFIG_LUCI_LANG_zh_Hant=n                  # 包含繁体中文语言支持

# CONFIG_FEED_video is not set
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y

### ZRAM内存压缩交换 ###
CONFIG_PACKAGE_zram-swap=y             # ZRAM内存压缩交换支持
CONFIG_PACKAGE_kmod-lib-lz4=y          # LZ4压缩算法内核模块
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y       # ZRAM使用LZ4压缩后端
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y       # ZRAM使用LZO压缩后端（备用）
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y      # ZRAM默认使用LZ4压缩算法

### USB驱动支持 ###
CONFIG_PACKAGE_kmod-usb2=n                   # USB 2.0 控制器驱动
CONFIG_PACKAGE_kmod-usb3=n                   # USB 3.0 控制器驱动
CONFIG_PACKAGE_kmod-usb-ohci=n               # OHCI USB控制器驱动（老设备）
CONFIG_PACKAGE_kmod-usb-uhci=n               # UHCI USB控制器驱动（Intel）
CONFIG_PACKAGE_kmod-usb-ehci=n               # EHCI USB控制器驱动（USB 2.0高速）
CONFIG_PACKAGE_kmod-usb-xhci=n               # xHCI USB控制器驱动（USB 3.0+）

# 核心 nftables 支持
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-compat=y  # 极其重要：提供 nft 兼容层
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow-table=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# 修复驱动缺失

CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_dae=n

# 修复你截图中的 iptables 报错
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y

# 强行集成 Tailscale 程序
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_tailscaled=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_luci-app-tailscale=y

CONFIG_PACKAGE_tmux=y                          # 终端多路复用器（类似screen但更强大）
CONFIG_PACKAGE_dmesg=y                         # 内核消息查看工具
CONFIG_PACKAGE_htop=y                          # 交互式进程查看器（基础版）
CONFIG_PACKAGE_btop=n                          # 资源监控工具（现代版，图形化更好）
CONFIG_PACKAGE_fdisk=n                         # 磁盘分区工具（MBR格式）
CONFIG_PACKAGE_cfdisk=n                        # 交互式磁盘分区工具（curses界面）
CONFIG_PACKAGE_sgdisk=n                        # GPT分区工具（用于GPT格式磁盘）
CONFIG_PACKAGE_tune2fs=n                       # ext2/ext3/ext4文件系统调整工具
CONFIG_PACKAGE_fstrim=n                        # SSD TRIM支持工具
CONFIG_PACKAGE_nano-full=y                     # Nano文本编辑器（完整功能版）
CONFIG_PACKAGE_autocore=y                      # 自动检测CPU架构和温度
CONFIG_PACKAGE_coremark=y                      # CPU性能基准测试工具
CONFIG_PACKAGE_hdparm=n                        # 硬盘参数获取/设置工具
CONFIG_PACKAGE_smartmontools-drivedb=n         # SMART硬盘监控工具数据库
CONFIG_PACKAGE_zoneinfo-asia=y                 # 亚洲时区数据
CONFIG_PACKAGE_acme-acmesh-dnsapi=n            # ACME DNS API支持（自动SSL证书）
CONFIG_PACKAGE_ddns-scripts-cloudflare=n       # CloudFlare DDNS脚本
CONFIG_PACKAGE_openssh-sftp-server=y           # OpenSSH SFTP服务器
CONFIG_PACKAGE_sqm-scripts-nss=n               # SQM QoS脚本（NSS加速版）

CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-app-nikki=n
CONFIG_PACKAGE_luci-app-momo=n
CONFIG_PACKAGE_luci-app-dae=n
CONFIG_PACKAGE_luci-theme-aurora=n
CONFIG_PACKAGE_luci-app-aurora-config=n
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wolplus=y             # Wake-on-LAN网络唤醒增强版
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-vlmcsd=y
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-frpc=n
CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-3cat=n
CONFIG_PACKAGE_luci-app-watchcat=n
CONFIG_PACKAGE_luci-proto-wireguard=y

CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-banip=y
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-usb-printer=n
CONFIG_PACKAGE_luci-app-oaf=n                   # OpenAppFilter应用过滤
CONFIG_PACKAGE_luci-app-sqm=n                   # SQM QoS流量管理
CONFIG_PACKAGE_luci-app-ttyd=n                  # 网页终端（通过浏览器访问shell）
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-wifischedule=n

### PassWall配置项 ###

CONFIG_PACKAGE_luci-app-passwall=n
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set
