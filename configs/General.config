CONFIG_DEVEL=y # 开发者选项（显示更多调试配置项）
CONFIG_CCACHE=y # 编译缓存，加速重复编译
CONFIG_PACKAGE_default-settings=y # 默认设置包
CONFIG_PACKAGE_default-settings-chn=y # 中国区默认设置（中文、国内源等）
CONFIG_TARGET_PER_DEVICE_ROOTFS=y # 每个设备型号单独生成根文件系统镜像
CONFIG_LUCI_LANG_zh_Hant=y # LuCI 界面繁体中文语言包

# CONFIG_FEED_video is not set # 视频相关软件源（未启用）
# CONFIG_FEED_nss_packages is not set # NSS 硬件网络加速软件源（未启用）
# CONFIG_FEED_sqm_scripts_nss is not set # NSS 版 SQM 限速脚本源（未启用）
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set # initramfs 内存根文件系统（未启用）

CONFIG_PACKAGE_zram-swap=y # zram 内存压缩交换空间（把内存当压缩交换区用，省内存）
CONFIG_PACKAGE_kmod-lib-lz4=y # LZ4 压缩算法内核模块（zram 依赖）
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y # 内核 zram 支持 LZ4 压缩算法
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y # 内核 zram 支持 LZO 压缩算法
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y # zram 默认使用 LZ4 压缩

# 核心 nftables 支持
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-compat=y  # 极其重要：提供 nft 兼容层
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-nf-flow=y # nftables 流卸载加速（flow offload）
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# 修复驱动缺失

CONFIG_PACKAGE_kmod-ip6tables-extra=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-xdp-sockets-diag=y
CONFIG_PACKAGE_luci-app-daed=n # daed 用预编译 apk 安装，不编译进固件

# daed 运行前提：内核 BTF + eBPF + XDP Socket（方式1：内核开 BTF，刷机后 apk add --force-depends 装 daed）
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_XDP_SOCKETS=y

# 修复 6.18 测试内核新增符号 ARM64_BRBE 无默认值导致的 syncconfig 交互卡死（OpenWrt 会把 CONFIG_KERNEL_* 自动转成内核 CONFIG_*）
# CONFIG_KERNEL_ARM64_BRBE is not set

# 修复你截图中的 iptables 报错
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y


CONFIG_PACKAGE_tmux=y # 终端多路复用器（一个窗口开多个终端会话）
CONFIG_PACKAGE_dmesg=y # 查看内核启动/运行日志
CONFIG_PACKAGE_htop=n # 交互式进程/资源查看器
CONFIG_PACKAGE_btop=y # 更美观的进程/资源监视器（htop 升级版）
CONFIG_PACKAGE_fdisk=y # 磁盘分区工具（MBR 分区表）
CONFIG_PACKAGE_cfdisk=y # 磁盘分区工具（交互式界面）
CONFIG_PACKAGE_sgdisk=y # 磁盘分区工具（GPT 分区表）
CONFIG_PACKAGE_tune2fs=y # 调整 ext2/3/4 文件系统参数
CONFIG_PACKAGE_fstrim=y # SSD TRIM 清理（回收固态硬盘空间、延寿）
CONFIG_PACKAGE_nano-full=y # 文本编辑器（完整版）
CONFIG_PACKAGE_autocore=y # 自动核心调优（自动配置 CPU 频率/性能）
CONFIG_PACKAGE_coremark=y # CoreMark CPU 性能跑分测试
CONFIG_PACKAGE_hdparm=y # 查看硬盘参数、测速
CONFIG_PACKAGE_smartmontools-drivedb=y # 硬盘 SMART 健康状态监控（含硬盘型号数据库）
CONFIG_PACKAGE_zoneinfo-asia=y # 亚洲时区数据（设置正确时间）
CONFIG_PACKAGE_acme-acmesh-dnsapi=y # ACME 免费 SSL 证书申请（DNS API 验证插件）
CONFIG_PACKAGE_ddns-scripts-cloudflare=y # Cloudflare 动态 DNS 更新脚本
CONFIG_PACKAGE_openssh-sftp-server=y # SSH 的 SFTP 文件传输服务
CONFIG_PACKAGE_sqm-scripts-nss=n # SQM QoS 智能限速脚本（NSS 版，关闭）

CONFIG_PACKAGE_luci-theme-aurora=n # LuCI 主题「极光 Aurora」
CONFIG_PACKAGE_luci-app-aurora-config=n # Aurora 主题配置界面
CONFIG_PACKAGE_luci-app-acme=y # 证书申请/续期管理界面
CONFIG_PACKAGE_luci-app-ddns=y # 动态 DNS 管理界面
CONFIG_PACKAGE_luci-app-upnp=y # UPnP 自动端口映射（游戏/下载机联网用）
CONFIG_PACKAGE_luci-app-wol=y # 网络唤醒 WOL（远程开机局域网设备）
CONFIG_PACKAGE_luci-app-samba4=y # Samba 文件共享（SMB4，局域网共享硬盘）
CONFIG_PACKAGE_luci-app-vlmcsd=n # KMS 激活服务器（激活 Windows/Office）
CONFIG_PACKAGE_luci-app-autoreboot=y # 定时自动重启
CONFIG_PACKAGE_luci-app-cpufreq=y # CPU 频率调节
CONFIG_PACKAGE_luci-app-uhttpd=y # 网页服务器管理界面（LuCI 底层依赖）
CONFIG_PACKAGE_luci-app-frps=y # frp 内网穿透服务端
CONFIG_PACKAGE_luci-app-frpc=y # frp 内网穿透客户端
CONFIG_PACKAGE_luci-app-diskman=y # 磁盘管理界面（分区/挂载）
CONFIG_PACKAGE_luci-app-hd-idle=y # 硬盘空闲自动休眠（省电、延寿）
CONFIG_PACKAGE_luci-app-3cat=n # 3cat 网络诊断/测速工具
CONFIG_PACKAGE_luci-app-watchcat=n # 看门狗（断网自动重启路由器）
CONFIG_PACKAGE_luci-proto-wireguard=y # WireGuard VPN 协议支持
CONFIG_PACKAGE_luci-app-nikki=y 
CONFIG_PACKAGE_luci-app-momo=y 

CONFIG_PACKAGE_luci-theme-argon=y # Argon 主题
CONFIG_PACKAGE_luci-app-argon-config=y # Argon 主题配置
CONFIG_PACKAGE_luci-app-banip=n # 禁止 IP（防火墙封禁，关闭）
CONFIG_PACKAGE_luci-app-arpbind=n # ARP 静态绑定（关闭）
CONFIG_PACKAGE_luci-app-usb-printer=n # USB 打印机共享（关闭）
CONFIG_PACKAGE_luci-app-oaf=n # OAF 应用过滤（关闭）
CONFIG_PACKAGE_luci-app-sqm=n # SQM QoS 智能限速（关闭）
CONFIG_PACKAGE_luci-app-ttyd=n # 网页终端 ttyd（关闭）
CONFIG_PACKAGE_luci-app-wechatpush=n # 微信推送通知（关闭）
CONFIG_PACKAGE_luci-app-smartdns=n # SmartDNS 智能 DNS（关闭）
CONFIG_PACKAGE_luci-app-lucky=y # Lucky 全能端口转发工具
CONFIG_PACKAGE_luci-app-openclash=n # OpenClash 科学上网
CONFIG_PACKAGE_luci-app-homeproxy=y # HomeProxy 科学上网（Sing-Box 内核，启用，保留调试）
CONFIG_PACKAGE_luci-app-passwall2=n # PassWall2 科学上网（关闭）
CONFIG_PACKAGE_luci-app-wifischedule=n # WiFi 定时开关（关闭）

### PassWall配置项 ### # PassWall 科学上网插件的细分配置

CONFIG_PACKAGE_luci-app-passwall=y # PassWall 科学上网主程序
# CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy is not set # iptables 透明代理（未启用）
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y # nftables 透明代理
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=y # GeoIP/GeoSite 地理分流数据库
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set # HAProxy 负载均衡（未启用）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y # Hysteria 协议（启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set # NaiveProxy 协议（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client is not set # Shadowsocks libev 客户端（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server is not set # Shadowsocks libev 服务端（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set # Shadowsocks Rust 客户端（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set # Shadowsocks Rust 服务端（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set # ShadowsocksR 客户端（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server is not set # ShadowsocksR 服务端（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set # ShadowTLS 伪装协议（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set # Simple-Obfs 流量混淆插件（未启用）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y # Sing-Box 通用代理核心（启用，PassWall 内可切换 Xray/Sing-Box 对比）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=y # Trojan-Plus 协议（启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set # TUIC 协议客户端（未启用）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata is not set # V2Ray 地理数据（未启用）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y # V2Ray 核心（启用）
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y # Xray 核心（当前 PassWall 用的代理核心）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set # Xray 插件（未启用）
